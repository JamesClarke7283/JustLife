# Godot's import settings (*.import) and stable resource IDs (*.uid) are source.
# Its cache, editor state and export credentials are local.
.godot/
/android/
.godot-editor/
export_credentials.cfg

# Builds and machine-local tooling.
/dist/
/.mcp.json
/.env
/.env.*
!/.env.example
__pycache__/
*.py[cod]
*.blend[0-9]*
.DS_Store

# Candidate model exports are reproducible local studies, never runtime assets.
/assets/models/*_rig*
/assets/models/*_grip*
/assets/audio/measurements.json

# Keep the authored artwork and its generators; leave renders, measurements,
# playthrough captures, iteration copies and source backups on the workstation.
/art/*
!/art/.gdignore
!/art/README.md
!/art/BRANDING_PROMPTS.md
!/art/ICON_PROMPT.md
!/art/SPLASH_PROMPT.md
!/art/characters.blend
!/art/characters_child.blend
!/art/characters_teen.blend
!/art/characters_elder.blend
!/art/furniture.blend
!/art/furniture_v2.blend
!/art/furniture_v60.blend
!/art/furniture/
/art/furniture/*
!/art/furniture/desk_booster.blend
!/art/furniture/oven.blend
!/art/furniture/oven.md
!/art/furniture/oven_manifest.json
!/art/celebration/
/art/celebration/*
!/art/celebration/birthday_cake.blend
!/art/meals/
/art/meals/*
!/art/meals/garden_supper.blend
!/art/meals/README.md
!/art/meals/manifest.json
!/art/recipes/
/art/recipes/*
!/art/recipes/recipe_variants.blend
!/art/recipes/README.md
!/art/recipes/manifest.json
!/art/source/
!/art/experiments/
/art/experiments/**/*.png
/art/experiments/**/*_preservation.json
/art/experiments/**/*.log

# Browser reference downloads are research material, not game source/assets.
/research/

# Editable architecture sources and contracts; generated previews stay local.
!/art/architecture/
/art/architecture/*
!/art/architecture/juniper_stair.blend
!/art/architecture/juniper_guardrails.blend
!/art/architecture/stair_geometry.json
!/art/architecture/guardrail_geometry.json
!/art/architecture/README.md
!/art/architecture/GUARDRAILS.md
!/art/architecture/justlife_roof_kit.blend
!/art/architecture/roof_geometry_contract.json
!/art/architecture/roof_parameters.json
!/art/architecture/ROOF_KIT.md
!/art/architecture/RUNTIME_ROOFS.md
!/art/architecture/publication_manifest.json

!/art/transport/
/art/transport/*
!/art/transport/juniper_car.blend

!/art/sanitation/
/art/sanitation/*
!/art/sanitation/juniper_mop.blend
!/art/sanitation/README.md
!/art/sanitation/manifest.json

!/art/vegetation/
/art/vegetation/*
!/art/vegetation/field_maples.blend
!/art/vegetation/README.md
!/art/vegetation/manifest.json
